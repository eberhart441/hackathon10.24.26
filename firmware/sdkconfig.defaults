# Common settings for every role and chip. See firmware/docs/serial-protocol.md.
# Console: UART at 921600 baud (the CSI stream is far too large for 115200).
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# Quiet logs so they rarely interleave with protocol lines.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# 1 ms ticks so the transmitter can hold 100 packets/s.
CONFIG_FREERTOS_HZ=1000

# Watchdog: a hung node reboots itself and resumes streaming.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# CSI capture (from the esp-csi csi_recv example).
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
