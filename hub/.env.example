# Copy to hub/.env (git-ignored) and edit. Every key is optional; these are the defaults.
# Relative paths resolve against the repository root.
HUB_BIND_HOSTS=127.0.0.1,192.168.137.1
HUB_PORT=8443
HUB_CERT_FILE=hub/certs/hub.pem
HUB_KEY_FILE=hub/certs/hub-key.pem
HUB_SECRETS_FILE=hub/config/secrets.json
HUB_FLOORPLAN_FILE=hub/config/floorplan.json
HUB_STATIC_DIR=hub/static
# Test only: 1 makes requests with header "X-Test-Remote: 1" count as non-loopback.
# Ignored unless every HUB_BIND_HOSTS entry is loopback. Leave at 0 for real use.
HUB_TEST_FORCE_REMOTE=0
