# Copy to hub/.env (git-ignored) and adjust. Real environment variables override this file.

# Addresses to listen on; any not present on the laptop are skipped with a warning.
# 172.20.10.2-14: laptop joined to the iPhone's Personal Hotspot (the setup that works for us).
# 192.168.137.1: Windows Mobile Hotspot (our iPhone could not join it).
HUB_BIND_HOSTS=127.0.0.1,172.20.10.2,172.20.10.3,172.20.10.4,172.20.10.5,172.20.10.6,172.20.10.7,172.20.10.8,172.20.10.9,172.20.10.10,172.20.10.11,172.20.10.12,172.20.10.13,172.20.10.14,192.168.137.1
HUB_PORT=8443

# mkcert certificate and key (paths relative to the repo root). Without them the hub
# serves plain HTTP on 127.0.0.1 only and the phone cannot connect. The cert must list every
# address above:
#   mkcert -cert-file hub/certs/hub.pem -key-file hub/certs/hub-key.pem localhost 127.0.0.1 192.168.137.1 172.20.10.2 172.20.10.3 172.20.10.4 172.20.10.5 172.20.10.6 172.20.10.7 172.20.10.8 172.20.10.9 172.20.10.10 172.20.10.11 172.20.10.12 172.20.10.13 172.20.10.14
HUB_CERT_FILE=hub/certs/hub.pem
HUB_KEY_FILE=hub/certs/hub-key.pem

# Mock hub only: timeline speed-up factor.
MOCK_SPEED=1
